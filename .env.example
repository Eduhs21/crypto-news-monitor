# Copy to .env and fill in your own credentials. Never commit the real .env.

# Google Gemini (https://aistudio.google.com/apikey) - required for --buy/--sell
# and for the automated trade signal.
GEMINI_API_KEY=your-gemini-api-key

# Telegram bot (talk to @BotFather to create one) - required for Telegram alerts
# and for the command listener.
TELEGRAM_BOT_TOKEN=123456789:AAExampleExampleExampleExampleExample
TELEGRAM_CHAT_ID=123456789

# Binance (optional) - read-only API key, used only by the /balance command.
# Leave blank and set binance.enabled=false in config.yaml to skip it entirely.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# MongoDB connection used for history. The docker-compose stack sets this for you.
MONGO_URI=mongodb://localhost:27017/cryptopanic
